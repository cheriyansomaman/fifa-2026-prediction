# Firebase configuration - copy this file to .env and fill in your own values
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_ADMIN_WHATSAPP=       # admin WhatsApp number (digits only, with country code, e.g. 919633282270)

# WARNING: Do NOT use the VITE_ prefix for secrets (API tokens, bot tokens, etc.).
# The VITE_ prefix makes variables available in the browser bundle, exposing them
# to every visitor. Telegram notifications should be handled server-side.
# TELEGRAM_BOT_TOKEN=       # server-side only — never prefix with VITE_
# TELEGRAM_ADMIN_CHAT_ID=   # server-side only — never prefix with VITE_
